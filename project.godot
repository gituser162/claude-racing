[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="cars"
3d_physics/layer_3="checkpoints"
3d_physics/layer_4="skills"
3d_physics/layer_5="barriers"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.web=0

[shader_globals]

psx_detail={
"type": "sampler2D",
"value": "res://assets/textures/detail.png"
}
beat_pulse={
"type": "float",
"value": 0.0
}
music_bands_lo={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
music_bands_hi={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
beat_wave={
"type": "vec4",
"value": Vector4(0, 0, 0, 100)
}
beat_wave_strength={
"type": "float",
"value": 0.0
}
